{
  "openapi": "3.0.0",
  "paths": {
    "/items/{id}": {
      "parameters": [
        {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
        {"$ref": "#/components/parameters/Skip"}
      ],
      "x-ignored": {"parameters": [{"name": "x", "in": "query", "schema": {"type": "string"}}]},
      "get": {
        "parameters": [
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1.0, "maximum": 100, "exclusiveMaximum": true, "format": "int32"}},
          {"name": "day", "in": "query", "required": 1, "x-mcp": true, "description": "ignored at param level", "schema": {"type": "string", "format": "date", "description": "A day\nwith newline", "example": "2024-01-01"}},
          {"name": "at", "in": "header", "schema": {"type": "string", "format": "time"}},
          {"name": "ts", "in": "query", "schema": {"type": "string", "format": "date-time"}},
          {"name": "empty", "in": "query", "schema": {}},
          {"name": "tags", "in": "query", "schema": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "enum": ["a", "b", null], "minLength": 2}}}
        ],
        "responses": {"200": {"description": "ok"}}
      },
      "post": {
        "parameters": [
          {"name": "w", "in": "query", "schema": {"type": "number", "minimum": 0.5, "exclusiveMinimum": true, "maximum": 1e20}},
          {"name": "big", "in": "query", "schema": {"type": "integer", "minimum": 1e20, "maximum": 1.5}}
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Color": {"type": "string", "enum": ["red", "green"], "description": "A colour"},
      "Level": {"type": "integer", "enum": [1, 2, 3], "minimum": 1},
      "Obj": {"type": "object", "properties": {"a": {"type": "string"}}},
      "Ints": {"type": "array", "items": {"type": "integer", "maximum": 9}},
      "Flag": {"type": "boolean"},
      "Mcp": {
        "type": "object",
        "x-mcp": true,
        "required": ["name", "active", "maybe", "color", "level", "nested"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z]+$", "description": "  The name  ", "example": "bob"},
          "active": {"type": "boolean", "description": "Is active."},
          "maybe": {"type": "boolean", "nullable": true, "example": true},
          "opt_bool": {"type": "boolean"},
          "color": {"allOf": [{"$ref": "#/components/schemas/Color"}], "description": "Wrapper wins", "example": "red"},
          "level": {"allOf": [{"$ref": "#/components/schemas/Level"}]},
          "obj_ref": {"$ref": "#/components/schemas/Obj"},
          "ints_ref": {"allOf": [{"$ref": "#/components/schemas/Ints"}]},
          "missing_ref": {"$ref": "#/components/schemas/Nope"},
          "external_ref": {"$ref": "other.json#/Foo"},
          "two_refs": {"oneOf": [{"$ref": "#/components/schemas/Color"}, {"$ref": "#/components/schemas/Level"}]},
          "mixed": {"anyOf": [{"$ref": "#/components/schemas/Color"}, {"type": "string", "maxLength": 3}], "type": "string"},
          "inline_enum": {"type": "string", "enum": ["x", "y"]},
          "int_enum": {"type": "integer", "enum": [0, 5]},
          "nested": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": -1.25}}},
          "ref_items": {"type": "array", "items": {"$ref": "#/components/schemas/Obj"}},
          "map": {"type": "object", "minProperties": 1, "maxProperties": 10},
          "custom": {"type": "string", "x-validator": "  email  "},
          "json_ex": {"type": "object", "example": {"k": "v\"q", "n": [1, 2.0, null], "u": "héllo\n"}},
          "only_ex": {"type": "integer", "example": 42},
          "dotted": {"type": "string", "description": "Ends with dot.", "example": "it's"},
          "unicode": {"type": "string", "description": "Ünïcødé — ok ✓", "x-mcp": false}
        }
      },
      "Composed": {
        "required": ["base"],
        "allOf": [
          {"$ref": "#/components/schemas/Obj"},
          {"type": "object", "required": ["extra"], "properties": {"base": {"type": "string"}, "extra": {"type": "integer"}, "other": {"type": "boolean", "x-mcp": true, "description": "d"}}}
        ]
      },
      "Existing": {
        "type": "object",
        "required": ["a"],
        "properties": {
          "a": {"type": "string", "maxLength": 3, "x-oapi-codegen-extra-tags": {"json": "a", "validate": "required,alpha"}},
          "b": {"type": "string", "x-mcp": true, "description": "b", "x-oapi-codegen-extra-tags": {"jsonschema": "old"}}
        }
      },
      "EmptyThings": {"type": "object", "properties": {}, "x-list": [], "x-obj": {}},
      "Weird": {"type": "string", "enum": [true, false, 1.0, 2, "s"], "x-mcp": true, "example": [1, "two"]},
      "Dup": {"type": "string", "description": "first", "description": "second"},
      "Escapes": {"type": "string", "description": "tab\tquote\"back\\slash\u0001ctl sep", "x-n": [1.0, 1e-7, 1e16, 123456789012345678901234567890, -0, 3.14159, 1E5, 0.0001]}
    },
    "parameters": {"Skip": {"name": "skip", "in": "query", "schema": {"type": "string"}}}
  }
}
