    "/covers/{isbn}": {
      "get": {
        "operationId": "booksCover",
        "description": "Get a book cover by ISBN (REST style, with path and query parameters).",
        "parameters": [
          {
            "name": "isbn",
            "in": "path",
            "description": "The ISBN.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "width",
            "in": "query",
            "description": "Cover width in pixels.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 2048,
              "minimum": 16
            },
            "explode": false
          },
          {
            "name": "format",
            "in": "query",
            "description": "Image format.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "jpeg"
              ]
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookModelId"
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorError400"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonErrorError404"
                }
              }
            }
          }
        },
        "tags": [
          "Book"
        ]
      }
    },
